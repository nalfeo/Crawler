#!/usr/bin/env sh
set -eu

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$staged_files" ]; then
  exit 0
fi

stashed=0
cleanup() {
  if [ "$stashed" -eq 1 ]; then
    git stash pop -q >/dev/null
  fi
}
trap cleanup EXIT INT TERM

if ! git diff --quiet; then
  git stash push -q --keep-index -m "pre-commit-format-stash"
  stashed=1
fi

echo "Running Prettier on staged files..."
repo_root="$(git rev-parse --show-toplevel)"
common_git_dir="$(git rev-parse --git-common-dir)"
prettier_entry="$repo_root/node_modules/prettier/bin/prettier.cjs"
if [ ! -f "$prettier_entry" ]; then
  prettier_entry="$common_git_dir/../node_modules/prettier/bin/prettier.cjs"
fi
if [ ! -f "$prettier_entry" ]; then
  echo "Prettier is not installed. Run npm install."
  exit 1
fi
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 node "$prettier_entry" --ignore-unknown --write --
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 git add --
