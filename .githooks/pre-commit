#!/usr/bin/env sh
set -eu

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$staged_files" ]; then
  exit 0
fi

prettier_targets="$(printf '%s\n' "$staged_files" | grep -E '\.(ts|tsx|js|jsx|json|md|css|scss|yml|yaml)$' || true)"

if [ -z "$prettier_targets" ]; then
  exit 0
fi

echo "Running Prettier on staged files..."
printf '%s\n' "$prettier_targets" | xargs npx prettier --write
printf '%s\n' "$prettier_targets" | xargs git add --
