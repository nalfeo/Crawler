#!/usr/bin/env sh
set -eu

echo "Running Prettier check before push..."
# Avoid npm/npx path resolution issues in Git Bash on Windows by invoking the
# local Prettier entrypoint directly with Node.
repo_root="$(git rev-parse --show-toplevel)"
common_git_dir="$(git rev-parse --git-common-dir)"
prettier_entry="$repo_root/node_modules/prettier/bin/prettier.cjs"
if [ ! -f "$prettier_entry" ]; then
  prettier_entry="$common_git_dir/../node_modules/prettier/bin/prettier.cjs"
fi
if [ ! -f "$prettier_entry" ]; then
  echo "Prettier is not installed. Run npm install."
  exit 1
fi
node "$prettier_entry" --check "src/**/*.ts" "tests/**/*.ts" "scripts/**/*.ts"

# Bot commit guard: catch any overlong or malformed commit subjects that slipped
# past the commit-msg hook (e.g. --no-verify commits).  Reads the push ref-pairs
# that git writes to stdin.
echo "Running bot commit guard (pre-push)..."
guard="$repo_root/scripts/agent/bot-commit-guard.mjs"
if [ -f "$guard" ]; then
  node "$guard" --check-push
else
  echo "[bot-commit-guard] Guard script not found at $guard — skipping." >&2
fi
