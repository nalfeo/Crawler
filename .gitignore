node_modules/
dist/
coverage/
*.local
.DS_Store
.tsbuildinfo
.tsbuildinfo-*
.vitest-cache/
.eslintcache
.cache/
tmp/

# TypeScript in-place compiled outputs (scripts and source dirs that use tsc without outDir)
scripts/sprites/**/*.js
scripts/sprites/**/*.js.map
scripts/sprites/**/*.d.ts
scripts/sprites/**/*.d.ts.map
src/devtools/*.js
src/devtools/*.js.map
src/devtools/*.d.ts
src/devtools/*.d.ts.map
src/engine/sprites/*.js
src/engine/sprites/*.js.map
src/engine/sprites/*.d.ts
src/engine/sprites/*.d.ts.map

# Sprite-generation pipeline scratch artifacts (raw candidates, processed
# variants, judge scorecards). Approved sprites live under public/assets/
# generated/ and ARE checked in. See .specify/specs/sprite-generation-pipeline.md.
generated/
!public/assets/generated/
!public/assets/generated/**

_check-merge.sh


# Local automation report drops
.automation-reports-local/

# Local environment credentials (populate via scripts/setup-azure-env.ps1)
# Variable names documented in scripts/azure-env.example.
# .env.local is already covered by the *.local rule above; listed explicitly for clarity.
.env.local
.env
