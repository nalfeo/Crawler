{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nalfeo/Crawler/docs/knowledge/epics/floor-2-equipment/epic-state.schema.json",
  "title": "Crawler durable epic state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "epic_id",
    "title",
    "updated_at",
    "plan",
    "authority",
    "lifecycle",
    "claim_policy",
    "github",
    "issue_materialization",
    "release",
    "nodes",
    "reconciliation"
  ],
  "properties": {
    "$schema": {
      "const": "./epic-state.schema.json"
    },
    "schema_version": {
      "const": "crawler-epic-state/v1"
    },
    "epic_id": {
      "const": "floor-2-equipment"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contract_version", "contract_sha256"],
      "properties": {
        "path": {
          "const": "docs/knowledge/epics/floor-2-equipment/PLAN.md"
        },
        "contract_version": {
          "const": "floor-2-equipment/v1"
        },
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_role", "sole_global_writer", "ordered_sources"],
      "properties": {
        "state_role": {
          "const": "index-cache"
        },
        "sole_global_writer": {
          "const": "Producer"
        },
        "ordered_sources": {
          "type": "array",
          "prefixItems": [
            {
              "const": "merged-git-and-pr-facts"
            },
            {
              "const": "deterministic-commit-addressed-evidence"
            },
            {
              "const": "trusted-issue-ownership-and-comments"
            },
            {
              "const": "epic-state-index-cache"
            }
          ],
          "items": false,
          "minItems": 4
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normal", "terminal"],
      "properties": {
        "normal": {
          "type": "array",
          "prefixItems": [
            {
              "const": "blocked"
            },
            {
              "const": "ready"
            },
            {
              "const": "claimed"
            },
            {
              "const": "in_progress"
            },
            {
              "const": "pr_open"
            },
            {
              "const": "merged"
            },
            {
              "const": "validated"
            }
          ],
          "items": false,
          "minItems": 7
        },
        "terminal": {
          "type": "array",
          "prefixItems": [
            {
              "const": "cancelled"
            },
            {
              "const": "superseded"
            }
          ],
          "items": false,
          "minItems": 2
        }
      }
    },
    "claim_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "bootstrap_node",
        "default_lease_hours",
        "maximum_without_heartbeat_hours",
        "protocol_headings"
      ],
      "properties": {
        "authority": {
          "const": "trusted-issue-comments"
        },
        "bootstrap_node": {
          "const": "slice:A0"
        },
        "default_lease_hours": {
          "const": 24
        },
        "maximum_without_heartbeat_hours": {
          "const": 48
        },
        "protocol_headings": {
          "type": "array",
          "prefixItems": [
            {
              "const": "CLAIMED"
            },
            {
              "const": "STACKED-WORK"
            },
            {
              "const": "BLOCKED"
            },
            {
              "const": "UNBLOCKED"
            },
            {
              "const": "SCOPE-CHANGE-REQUEST"
            },
            {
              "const": "HANDOFF"
            }
          ],
          "items": false,
          "minItems": 6
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "parent_issue"],
      "properties": {
        "repository": {
          "const": "nalfeo/Crawler"
        },
        "parent_issue": {
          "$ref": "#/$defs/nullableIssueRef"
        }
      }
    },
    "issue_materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "parent_title", "child_title_prefix", "labels", "late_bound_fields"],
      "properties": {
        "mode": {
          "const": "deterministic-plan-only"
        },
        "parent_title": {
          "type": "string",
          "minLength": 1
        },
        "child_title_prefix": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "late_bound_fields": {
          "type": "array",
          "items": {
            "enum": ["parent_issue_number", "child_issue_number"]
          },
          "uniqueItems": true
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_node_status", "all_required_nodes", "flags"],
      "properties": {
        "required_node_status": {
          "const": "validated"
        },
        "all_required_nodes": {
          "const": true
        },
        "flags": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/releaseFlag" },
                { "properties": { "name": { "const": "floor2EquipmentRegistry" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/releaseFlag" },
                { "properties": { "name": { "const": "floor2EquipmentCatalog" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/releaseFlag" },
                { "properties": { "name": { "const": "floor2EquipmentRewards" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/releaseFlag" },
                { "properties": { "name": { "const": "floor2EquipmentEconomy" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/releaseFlag" },
                { "properties": { "name": { "const": "floor2EquipmentUx" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/releaseFlag" },
                { "properties": { "name": { "const": "floor2EquipmentWorld" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/releaseFlag" },
                { "properties": { "name": { "const": "floor2EquipmentAiMaintenance" } } }
              ]
            }
          ],
          "items": false
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 37,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "last_offline_validation_at",
        "last_github_audit_at",
        "last_reconciled_by",
        "drift"
      ],
      "properties": {
        "mode": {
          "const": "read-only-proposal"
        },
        "last_offline_validation_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "last_github_audit_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "last_reconciled_by": {
          "type": ["string", "null"]
        },
        "drift": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableDateTime": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "nullableSha": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha40": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha40"
        },
        {
          "type": "null"
        }
      ]
    },
    "issueRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/nalfeo/Crawler/issues/[1-9][0-9]*$"
        }
      }
    },
    "nullableIssueRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/issueRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "prRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url", "head_sha"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/nalfeo/Crawler/pull/[1-9][0-9]*$"
        },
        "head_sha": {
          "$ref": "#/$defs/sha40"
        }
      }
    },
    "nullablePrRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/prRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path_or_check", "sha256", "commit", "recorded_at"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path_or_check": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "commit": {
          "$ref": "#/$defs/sha40"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimant",
        "session",
        "source",
        "scope",
        "claimed_at",
        "lease_expires_at",
        "heartbeat_at",
        "base_commit"
      ],
      "properties": {
        "claimant": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "^(?!\\s*$).+" }
          ]
        },
        "session": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "^(?!\\s*$).+" }
          ]
        },
        "source": {
          "enum": ["none", "parent-issue-bootstrap", "child-issue-comment"]
        },
        "scope": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "^(?!\\s*$).+" }
          ]
        },
        "claimed_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "lease_expires_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "heartbeat_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "base_commit": {
          "$ref": "#/$defs/nullableSha"
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "merged_at"],
      "properties": {
        "commit": {
          "$ref": "#/$defs/nullableSha40"
        },
        "merged_at": {
          "$ref": "#/$defs/nullableDateTime"
        }
      }
    },
    "nodeReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_audited_at",
        "observed_issue_state",
        "observed_pr_state",
        "observed_head_sha",
        "observed_merge_commit",
        "drift"
      ],
      "properties": {
        "last_audited_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "observed_issue_state": {
          "enum": ["open", "closed", null]
        },
        "observed_pr_state": {
          "enum": ["OPEN", "CLOSED", "MERGED", null]
        },
        "observed_head_sha": {
          "$ref": "#/$defs/nullableSha40"
        },
        "observed_merge_commit": {
          "$ref": "#/$defs/nullableSha40"
        },
        "drift": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "display_id",
        "kind",
        "parent_slice",
        "title",
        "summary",
        "execution_lane",
        "persona",
        "dependencies",
        "status",
        "release_requirement",
        "deferred_reason",
        "status_changed_at",
        "github",
        "ownership",
        "merge",
        "evidence_requirements",
        "evidence",
        "reconciliation",
        "superseded_by"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^(slice|packet):[A-Z0-9][A-Z0-9+.-]*$"
        },
        "display_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9+.-]*$"
        },
        "kind": {
          "enum": ["slice", "cloud_packet"]
        },
        "parent_slice": {
          "type": ["string", "null"],
          "pattern": "^slice:[A-Z0-9][A-Z0-9+.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "execution_lane": {
          "enum": [
            "control",
            "registry",
            "catalog-balance",
            "progression",
            "economy",
            "accessible-ux",
            "world-integration",
            "ai-settlement",
            "verification"
          ]
        },
        "persona": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(slice|packet):[A-Z0-9][A-Z0-9+.-]*$"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "blocked",
            "ready",
            "claimed",
            "in_progress",
            "pr_open",
            "merged",
            "validated",
            "cancelled",
            "superseded"
          ]
        },
        "release_requirement": {
          "enum": ["required", "deferred"]
        },
        "deferred_reason": {
          "type": ["string", "null"]
        },
        "status_changed_at": {
          "type": "string",
          "format": "date-time"
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issue", "pr"],
          "properties": {
            "issue": {
              "$ref": "#/$defs/nullableIssueRef"
            },
            "pr": {
              "$ref": "#/$defs/nullablePrRef"
            }
          }
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "merge": {
          "$ref": "#/$defs/merge"
        },
        "evidence_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "reconciliation": {
          "$ref": "#/$defs/nodeReconciliation"
        },
        "superseded_by": {
          "type": ["string", "null"],
          "pattern": "^(slice|packet):[A-Z0-9][A-Z0-9+.-]*$"
        },
        "stacked_work": {
          "anyOf": [
            {
              "$ref": "#/$defs/stackedWork"
            },
            {
              "type": "null"
            }
          ],
          "description": "Speculative stacked-work metadata. Optional — absent when there is no active speculative work. The node status stays blocked; this is orthogonal to the normal lifecycle."
        }
      }
    },
    "stackBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_node_id",
        "dependency_pr_number",
        "dependency_branch",
        "dependency_head_sha",
        "last_resynced_at",
        "last_resynced_head",
        "requires_main_rebase"
      ],
      "properties": {
        "dependency_node_id": {
          "type": "string",
          "pattern": "^(slice|packet):[A-Z0-9][A-Z0-9+.-]*$"
        },
        "dependency_pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "dependency_branch": {
          "type": "string",
          "minLength": 1
        },
        "dependency_head_sha": {
          "$ref": "#/$defs/sha40",
          "description": "The dep's head SHA at the time speculative work was initiated."
        },
        "last_resynced_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_resynced_head": {
          "$ref": "#/$defs/sha40",
          "description": "The dep's head SHA at the most recent resync. Stale when this differs from the dep node's cached github.pr.head_sha."
        },
        "requires_main_rebase": {
          "type": "boolean",
          "description": "Set to true once the dep PR merges. Blocks normal lifecycle advancement until the stacked branch is rebased onto main."
        }
      }
    },
    "stackedWork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "issue", "session", "branch", "pr", "stack_bases", "drift_reason"],
      "properties": {
        "mode": {
          "enum": ["stacked_in_progress", "stacked_pr_open"]
        },
        "issue": {
          "$ref": "#/$defs/issueRef"
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "pr": {
          "anyOf": [
            {
              "$ref": "#/$defs/prRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only when mode is stacked_pr_open."
        },
        "stack_bases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stackBase"
          }
        },
        "drift_reason": {
          "type": ["string", "null"]
        }
      }
    },
    "releaseFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "default", "validating_nodes"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "const": false
        },
        "validating_nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^slice:[A-Z0-9][A-Z0-9+.-]*$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
