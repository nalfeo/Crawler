{
  "$comment": "Default brief settings for floor, wall, and terrain tile sprites.",
  "size": { "width": 256, "height": 256 },
  "palette": { "id": "kenney-roguelike" },
  "anchor": { "x": 128, "y": 255 },
  "tags": ["tile", "terrain", "environment"],
  "generation": {
    "sheet": { "rows": 4, "cols": 4, "emptyCells": [], "nativeCanvas": 1024 }
  },
  "postprocessing": {
    "trimAndFit": false,
    "minDimension": 256
  },
  "sensors": {
    "edge": { "allowMainTouch": true },
    "anchor": { "derive": true, "bandRows": 8, "centerToleranceX": 8 }
  },
  "minVariations": 2,
  "judge": { "enabled": true, "maxVariants": 16 }
}
