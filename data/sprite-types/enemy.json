{
  "$comment": "Default brief settings for hostile mob sprites. Keeps enemy briefs minimal while anchoring them to the existing CC0 reference packs and the shared Kenney palette.",
  "size": { "width": 64, "height": 64 },
  "palette": { "id": "kenney-roguelike" },
  "anchor": { "x": 32, "y": 32 },
  "tags": ["enemy", "mob"],
  "references": [
    {
      "path": "public/assets/kenney/roguelike-characters/spritesheet.png",
      "note": "primary character and enemy silhouettes in the house style"
    },
    {
      "path": "public/assets/kenney/tiny-dungeon/spritesheet.png",
      "note": "secondary dungeon monsters, props, and palette support"
    }
  ],
  "generation": {
    "sheet": { "rows": 4, "cols": 4, "emptyCells": [], "nativeCanvas": 1024 }
  },
  "sensors": {
    "edge": {
      "allowMainTouch": false,
      "allowDetachedEdgeComponents": false,
      "maxDetachedEdgePixels": 0
    },
    "enemy": { "facing": "front" },
    "anchor": { "mode": "center-of-mass" }
  },
  "minVariations": 4,
  "judge": { "enabled": true, "maxVariants": 16 }
}
