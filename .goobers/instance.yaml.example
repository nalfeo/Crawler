apiVersion: goobers.dev/v1alpha1
kind: Instance
repos:
  - provider: github
    owner: nalfeo
    name: Crawler
    token:
      env: GOOBERS_GITHUB_TOKEN
runner:
  # Bound one stage independently so a heavy Codex or verification process
  # cannot OOM-kill the daemon and every other in-flight run.
  stageMemoryLimit: 8Gi
  envPassthrough:
    - GOOBERS_INSTANCE
    - GOOBERS_RECOVERY_ISSUE
    - GOOBERS_INTAKE_COHORT
    - GOOBERS_RESUME_BRANCH
    - GOOBERS_RESUME_CHECKPOINT_SHA
    - GOOBERS_RESUME_FAILURE
    - GOOBERS_IMPLEMENTATION_TIMEOUT_MINUTES
runConditions:
  # The local daemon shares this cap across workflows: one implementation run
  # plus up to four simultaneous PR-remediation runs. The disabled hosted
  # goobers-run.yml path overrides each throwaway slot root back to 1.
  maxParallelRuns: 5
