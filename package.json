{
  "name": "crawler",
  "version": "0.1.0",
  "private": true,
  "description": "A crafting-focused vampire-survivors-like set inside a brutal intergalactic reality show dungeon",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/agent/setup-git-hooks.mjs",
    "postinstall": "playwright install chromium",
    "dev": "vite",
    "build": "vite build",
    "build:typed": "tsc --noEmit --project tsconfig.src.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:src": "tsc --noEmit --project tsconfig.src.json",
    "lint": "eslint src/ tests/ scripts/ --max-warnings 0",
    "lint:cache": "eslint src/ tests/ scripts/ --cache --cache-location .cache/eslint/.eslintcache --max-warnings 0",
    "lint:core": "eslint src/core/ tests/ecs/ tests/property/ --cache --cache-location .cache/eslint/.eslintcache --max-warnings 0",
    "lint:game": "eslint src/game/ tests/game/ --cache --cache-location .cache/eslint/.eslintcache --max-warnings 0",
    "lint:engine": "eslint src/engine/ tests/unit/ --cache --cache-location .cache/eslint/.eslintcache --max-warnings 0",
    "lint:labs": "eslint src/labs/ tests/unit/ --cache --cache-location .cache/eslint/.eslintcache --max-warnings 0",
    "lint:fix": "eslint src/ tests/ scripts/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:dead-code": "knip --dependencies --no-config-hints",
    "test": "vitest run",
    "test:changed": "vitest run --changed --project unit --reporter=dot --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:headless": "vitest run --project headless --reporter=verbose",
    "lab": "vite --mode lab",
    "devtools": "vite --mode devtools",
    "ai:headless": "tsx src/game/ai/headless-runner-cli.ts",
    "sprites:extract-palette": "tsx scripts/sprites/extract-palette.ts",
    "sprites:run": "tsx scripts/sprites/cli.ts",
    "sprites:gallery": "tsx scripts/sprites/sidecar/launcher.ts",
    "sprites:approve": "tsx scripts/sprites/approve-cli.ts",
    "sprites:synth": "tsx scripts/sprites/synth-cli.ts",
    "sprites:batch": "tsx scripts/sprites/batch-cli.ts",
    "sprites:asset-plan": "tsx scripts/sprites/asset-plan-cli.ts",
    "sprites:plan-drafts": "tsx scripts/sprites/plan-drafts-cli.ts",
    "sprites:enqueue": "tsx scripts/sprites/queue-cli.ts",
    "sprites:worker": "tsx scripts/sprites/worker-cli.ts",
    "sprites:sync-catalog": "tsx scripts/sprites/sync-catalog.ts",
    "sprites:metadata": "tsx scripts/sprites/metadata-pipeline.ts",
    "verify:fast": "bash scripts/agent/verify-fast.sh",
    "verify:flash": "vitest run --changed --project unit --reporter=dot",
    "verify": "bash scripts/agent/verify.sh",
    "verify:core": "npm run typecheck:src && npm run lint:core && vitest run tests/ecs tests/property --reporter=dot",
    "verify:game": "npm run typecheck:src && npm run lint:game && vitest run tests/game --reporter=dot",
    "verify:engine": "npm run typecheck:src && npm run lint:engine && vitest run tests/unit --reporter=dot",
    "verify:labs": "npm run typecheck:src && npm run lint:labs",
    "perf:baseline": "tsx scripts/agent/perf/baseline.ts",
    "bench": "vitest bench",
    "docs:check": "tsx scripts/agent/docs/check-paths.ts && tsx scripts/agent/docs/check-adr-consistency.ts && tsx scripts/agent/docs/check-readme-commands.ts && tsx scripts/agent/docs/check-personas.ts && tsx scripts/agent/docs/stale-game-design.ts && tsx scripts/agent/docs/promote-handoffs.ts && tsx scripts/agent/docs/archive-handoffs.ts",
    "security:check": "npm audit --audit-level=high && bash scripts/agent/security/scan-secrets.sh && tsx scripts/agent/security/check-codeowners.ts && tsx scripts/agent/security/check-deps.ts && bash scripts/agent/security/check-dynamic-patterns.sh && tsx scripts/agent/security/check-ai-prompts.ts",
    "health:check": "vitest run --project unit --coverage --reporter=dot && tsx scripts/agent/health/coverage-trend.ts && tsx scripts/agent/health/untested-systems.ts && tsx scripts/agent/health/extended-property.ts && tsx scripts/agent/health/governor-playthroughs.ts && tsx scripts/agent/health/balance-regression.ts && tsx scripts/agent/health/bench-regression.ts"
  },
  "keywords": [
    "game",
    "vampire-survivors",
    "ecs",
    "phaser",
    "roguelite"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "bitecs": "^0.4.0",
    "canvas": "^3.2.3",
    "loglevel": "^1.9.2",
    "phaser": "^4.1.0",
    "rot-js": "^2.2.1"
  },
  "devDependencies": {
    "@azure/storage-blob": "^12.32.0",
    "@azure/storage-queue": "^12.30.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.9.1",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "fast-check": "^4.8.0",
    "fastify": "^5.8.5",
    "globals": "^17.6.0",
    "knip": "^6.15.0",
    "lil-gui": "^0.21.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}
